{
  "expo": {
    "name": "Covered",
    "slug": "covered",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "covered",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "gr.plenum.covered-app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "covered",
              "com.plenum.covered.app",
              "com.googleusercontent.apps.1001340597486-tp514u7qv82a06472643b1il7b8j6biv"
            ]
          }
        ]
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "gr.plenum.covered",
      "adaptiveIcon": {
        "backgroundColor": "#150F36",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "./plugins/with-no-push-entitlement",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#150F36",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Covered uses your photos so you can attach receipts and manuals to an item.",
          "cameraPermission": "Covered uses the camera so you can photograph receipts and serial plates."
        }
      ],
      "expo-notifications",
      "./plugins/with-unity-android-sdk",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1001340597486-tp514u7qv82a06472643b1il7b8j6biv"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ],
          "disableAndroidLegacyFilters": true,
          "iosAppGroupIdentifier": "group.gr.plenum.covered"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
