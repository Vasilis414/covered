# Receipt AI configuration.
#
# PRODUCTION — point the app at your own backend, which holds the API key.
# Nothing secret ends up in the APK.
# EXPO_PUBLIC_RECEIPT_AI_ENDPOINT=https://your-worker.example.com/scan
#
# DEVELOPMENT ONLY — calls Gemini directly from the phone.
# EXPO_PUBLIC_* values are inlined into the JS bundle, so this key is readable
# by anyone who unzips the APK. Never ship a build with this set.
# EXPO_PUBLIC_GEMINI_API_KEY=your-key-here
